# FluxEye 后端环境变量配置
# 复制为 .env 文件后修改

# 存储后端: sqlite | influxdb | clickhouse
FLUXEYE_STORAGE__BACKEND=sqlite

# SQLite
FLUXEYE_STORAGE__SQLITE__PATH=./data/fluxeye.db

# InfluxDB
FLUXEYE_STORAGE__INFLUXDB__URL=http://localhost:8086
FLUXEYE_STORAGE__INFLUXDB__TOKEN=fluxeye-token
FLUXEYE_STORAGE__INFLUXDB__ORG=fluxeye
FLUXEYE_STORAGE__INFLUXDB__BUCKET=flow_stats

# ClickHouse
FLUXEYE_STORAGE__CLICKHOUSE__HOST=localhost
FLUXEYE_STORAGE__CLICKHOUSE__PORT=9000
FLUXEYE_STORAGE__CLICKHOUSE__DATABASE=fluxeye
FLUXEYE_STORAGE__CLICKHOUSE__USER=default
FLUXEYE_STORAGE__CLICKHOUSE__PASSWORD=

# 采集器
FLUXEYE_COLLECTOR__INTERFACE=
FLUXEYE_COLLECTOR__BPF_FILTER=
FLUXEYE_COLLECTOR__PCAP_FILE=
FLUXEYE_COLLECTOR__FLUSH_INTERVAL=5.0
